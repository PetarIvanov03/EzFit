{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ImageStorage": {
    "Format": "Webp",
    "Quality": 80,
    "UploadsRoot": "App_Data/uploads"
  },
  "Uploads": {
    "MaxFileSizeBytes": 26214400,
    "MaxFileCount": 5,
    "MaxPixels": 50000000,
    "MaxTilesPerRequest": 20
  },
  "Gemini": {
    "Model": "gemini-3.5-flash-lite"
  },
  "RateLimiting": {
    "Log": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Api": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    }
  },
  "CurrentUser": {
    "Id": 1
  }
}
