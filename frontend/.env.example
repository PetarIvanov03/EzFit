# Default (fallback in src/api/client.ts) is https://localhost:7059/api.
# If the browser complains about the self-signed dev cert, either open
# https://localhost:7059/swagger once and accept it, or point this at the
# plain HTTP profile instead (see backend/EzFit/EzFit/Properties/launchSettings.json):
# VITE_API_URL=http://localhost:5222/api
VITE_API_URL=https://localhost:7059/api

# Shared key sent as X-Api-Key on every /api request, matched against the backend's
# Security:ApiKey. This is NOT a secret (it ships in the public frontend bundle) and is
# NOT a substitute for auth — it only stops casual scripted abuse until real auth lands.
# Leave unset to match a backend with no Security:ApiKey configured.
VITE_API_KEY=
